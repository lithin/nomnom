{
  "name": "nomnom",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "build": "npm run -w backend build",
    "dev": "npm run -w backend dev",
