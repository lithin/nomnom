project_id                       = "your-gcp-project-id"
region                           = "us-west2"
service_name                     = "nomnom-backend"
container_image                  = "us-west2-docker.pkg.dev/your-gcp-project-id/nomnom/backend:latest"
cloud_run_service_account_email  = ""
allow_unauthenticated            = true
min_instance_count               = 0
max_instance_count               = 1
cpu_limit                        = "1"
memory_limit                     = "512Mi"
