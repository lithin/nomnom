{
  "name": "nomnom",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "biome:check": "biome check .",
    "biome:write": "biome check --write .",
    "build": "npm run -w backend build",
    "deploy:backend": "bash ./infra/deploy_backend.sh",
    "docker:backend:push": "gcloud auth configure-docker us-west2-docker.pkg.dev && docker buildx build --platform linux/amd64 -t us-west2-docker.pkg.dev/nomnom452/nomnom/backend:latest --push ./backend",
    "dev": "npm run -w backend dev",
    "start": "npm run -w backend start",
    "typecheck": "npm run -w backend typecheck",
    "check": "npm run biome:check && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "prisma": "^7.6.0"
  },
  "dependencies": {
    "@prisma/client": "^7.6.0",
    "@react-navigation/native-stack": "^7.14.10"
  }
}
